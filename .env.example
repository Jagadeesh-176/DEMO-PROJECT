# Copy this file to .env and fill in your real values.
# .env is gitignored, so it is never committed or pushed.
#
# On Vercel, add these same two names under:
#   Project -> Settings -> Environment Variables
#
# Important: Vite writes VITE_ variables into the JavaScript the browser
# downloads. This keeps the details out of the source code and off the sign in
# screen, but it is not server side security. Anyone determined can still read
# them from the built files. Real protection would need a backend.

VITE_AUTH_EMAIL=you@example.com
VITE_AUTH_PASSWORD=change-me
